        }

        // Render Admin Dashboard Data & Analytics
        function renderAdminDashboard() {
            renderMetrics();
            renderAdminTable();
            renderChart();
        }

        function renderMetrics() {
            document.getElementById('statTotal').innerText = appointments.length;
            
            const emergencyCount = appointments.filter(a => a.priority === 'إسعاف').length;
            document.getElementById('statEmergency').innerText = emergencyCount;

            const urgentCount = appointments.filter(a => a.priority === 'حالة ضرورية').length;
            document.getElementById('statUrgent').innerText = urgentCount;

            const completedCount = appointments.filter(a => a.status === 'تم الكشف').length;
            document.getElementById('statCompleted').innerText = completedCount;
        }

        function renderAdminTable() {
            const tbody = document.getElementById('adminTableBody');
            const searchVal = document.getElementById('adminSearchInput').value.toLowerCase().trim();
            const clinicFilter = document.getElementById('adminClinicFilter').value;
            const priorityFilter = document.getElementById('adminPriorityFilter').value;
            const emptyState = document.getElementById('emptyTableState');

            tbody.innerHTML = '';

            const filtered = appointments.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(searchVal) || item.phone.includes(searchVal) || item.id.toLowerCase().includes(searchVal);
                const matchesClinic = clinicFilter === 'ALL' || item.clinic === clinicFilter;
                const matchesPriority = priorityFilter === 'ALL' || item.priority === priorityFilter;
                return matchesSearch && matchesClinic && matchesPriority;
            });

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            filtered.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";

                let priorityClass = "text-emerald-700 bg-emerald-50";
                if (item.priority === 'حالة ضرورية') priorityClass = "text-amber-700 bg-amber-50";
                if (item.priority === 'إسعاف') priorityClass = "text-red-700 bg-red-50 font-bold animate-pulse";

                tr.innerHTML = `
                    <td class="p-4 font-mono font-bold text-slate-900">${item.id}</td>
                    <td class="p-4 font-bold text-slate-800">${item.name}</td>
                    <td class="p-4">${item.age}</td>
                    <td class="p-4 font-mono" dir="ltr">${item.phone}</td>
                    <td class="p-4 font-semibold text-brand-700">${item.clinic}</td>
                    <td class="p-4">
                        <span class="px-2.5 py-1 rounded-full text-xs ${priorityClass}">
                            ${item.priority}
                        </span>
                    </td>
                    <td class="p-4 text-xs text-slate-600">${item.date} (${item.time})</td>
                    <td class="p-4">
                        <select onchange="updatePatientStatus('${item.id}', this.value)" class="text-xs px-2 py-1 rounded-lg border border-slate-300 font-bold focus:outline-none">
                            <option value="في الانتظار" ${item.status === 'في الانتظار' ? 'selected' : ''}>⏳ في الانتظار</option>
                            <option value="قيد المعاينة" ${item.status === 'قيد المعاينة' ? 'selected' : ''}>🩺 قيد المعاينة</option>
                            <option value="تم الكشف" ${item.status === 'تم الكشف' ? 'selected' : ''}>✅ تم الكشف</option>
                            <option value="ملغى" ${item.status === 'ملغى' ? 'selected' : ''}>❌ ملغى</option>
                        </select>
                    </td>
                    <td class="p-4 text-center">
                        <button onclick="deleteAppointment('${item.id}')" class="w-8 h-8 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition inline-flex items-center justify-center text-xs">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updatePatientStatus(id, newStatus) {
            const idx = appointments.findIndex(a => a.id === id);
            if (idx !== -1) {
                appointments[idx].status = newStatus;
                saveAppointments();
                renderMetrics();
                showAlert(`تم تحديث حالة المريض [${id}] إلى (${newStatus})`, 'info');
            }
        }

        function deleteAppointment(id) {
            appointments = appointments.filter(a => a.id !== id);
            saveAppointments();
            renderAdminDashboard();
            showAlert('تم حذف الحجز بنجاح.', 'info');
        }

        // TV Waiting Room Screen Overlay logic
        function toggleQueueTVView() {
            const tvOverlay = document.getElementById('tvQueueOverlay');
            if (tvOverlay.classList.contains('hidden')) {
                renderTVQueueGrid();
                tvOverlay.classList.remove('hidden');
            } else {
                tvOverlay.classList.add('hidden');
            }
        }

        function renderTVQueueGrid() {
            const grid = document.getElementById('tvQueueGrid');
            grid.innerHTML = '';

            const clinics = [
                'العيادة العينية',
                'العيادة السنية',
                'عيادة القلبية',
                'عيادة العصبية والمخ',
                'الجراحة العامة',
                'الإسعافات الأولية والطوارئ'
            ];

            clinics.forEach(cName => {
                const activePatient = appointments.find(a => a.clinic === cName && a.status === 'قيد المعاينة');
                const waitingPatients = appointments.filter(a => a.clinic === cName && a.status === 'في الانتظار');

                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 p-6 rounded-3xl flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-lg text-amber-400">${cName}</h3>
                            <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full">الانتظار: ${waitingPatients.length}</span>
                        </div>
                        <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 text-center mb-4">
                            <span class="text-xs text-slate-500 block mb-1">المعاينة الحالية (داخل العيادة)</span>
                            <span class="text-2xl font-black ${activePatient ? 'text-emerald-400 font-mono' : 'text-slate-600'}">
                                ${activePatient ? activePatient.id : 'لا يوجد مريض حالياً'}
                            </span>
                            <p class="text-xs font-bold text-slate-300 mt-1">${activePatient ? activePatient.name : ''}</p>
                        </div>
                    </div>
                    <div class="text-xs text-slate-400">
                        <span class="block mb-1 font-bold">التالي في الدور:</span>
                        <p class="font-mono text-slate-300">${waitingPatients.length > 0 ? waitingPatients[0].id + ' - ' + waitingPatients[0].name : 'لا يوجد مراجعين بنظام الانتظار'}</p>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Export data to CSV
        function exportToCSV() {
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF";
            csvContent += "رقم الدور,اسم المريض,العمر,الهاتف,القسم,نوع الحجز,التاريخ,الوقت,الحالة\n";

            appointments.forEach(row => {
                csvContent += `"${row.id}","${row.name}","${row.age}","${row.phone}","${row.clinic}","${row.priority}","${row.date}","${row.time}","${row.status}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `سجل_جمعية_الأفق_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Render Analytics Chart
        function renderChart() {
            const ctx = document.getElementById('deptChart');
            if (!ctx) return;

            const deptCounts = {};
            appointments.forEach(a => {
                deptCounts[a.clinic] = (deptCounts[a.clinic] || 0) + 1;
            });

            const labels = Object.keys(deptCounts);
            const data = Object.values(deptCounts);

            if (chartInstance) {
                chartInstance.destroy();
            }

            chartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: [
                            '#0284c7', '#0d9488', '#e11d48',
                            '#9333ea', '#d97706', '#dc2626'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Cairo' }
                            }
                        }
                    }
                }
            });
        }

        // Alert Banner Component
        function showAlert(msg, type = 'info') {
            const container = document.getElementById('alertContainer');
            let bg = 'bg-blue-50 text-blue-800 border-blue-200';
            if (type === 'success') bg = 'bg-emerald-50 text-emerald-800 border-emerald-200';
            if (type === 'warning') bg = 'bg-amber-50 text-amber-800 border-amber-200';

            container.className = `p-4 rounded-2xl border ${bg} text-xs md:text-sm font-bold flex justify-between items-center transition shadow-sm mb-6`;
            container.innerHTML = `
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-circle-check text-lg"></i>
                    <span>${msg}</span>
                </div>
                <button onclick="document.getElementById('alertContainer').classList.add('hidden')" class="text-xs opacity-60 hover:opacity-100">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            `;
            container.classList.remove('hidden');

            setTimeout(() => {
                container.classList.add('hidden');
            }, 6000);
        }
        function scrollToBooking() {
    // 1. الانتقال لتبويب الحجز
    if (typeof switchTab === 'function') {
        switchTab('booking');
    }
    
    // 2. التمرير السلس إلى نموذج الحجز والتركيز على اختيار العيادة
    setTimeout(() => {
        const bookingForm = document.getElementById('appointmentForm') || document.getElementById('bookingCard') || document.getElementById('tabBooking');
        const clinicSelect = document.getElementById('clinicDept');
        
        if (bookingForm) {
            bookingForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        
        if (clinicSelect) {
            clinicSelect.focus();
        }
    }, 200);
}
    </script>
</body>
</html>
